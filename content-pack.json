  "glossary": [
    {
      "id": "obo",
      "term": "On-behalf-of (OBO)",
      "definition": "One token exchange gives the agent a token where sub stays the person and act names the agent. The OBO token keeps the FULL scope set; it does not narrow per tool."
    },
    {
      "id": "hitl",
      "term": "Human-in-the-loop (HITL)",
      "definition": "A policy requirement that a sensitive action (here: any write) may only run after a human approves it. The approval is verified by Authorize, never trusted from the agent."
    },
    {
      "id": "ciba",
      "term": "CIBA",
      "definition": "Client Initiated Backchannel Authentication: Authorize starts an out-of-band approval request and returns an identifier that ties the DENY to the later PERMIT."
    },
    {
      "id": "identifier",
      "term": "The identifier",
      "definition": "Authorizes CIBA request id, returned in the 403, echoed by the agent in a header on replay. Single use: a second replay with the same identifier denies again."
    },
    {
      "id": "jsonrpc",
      "term": "JSON-RPC 2.0 error rewrite",
      "definition": "The gateway rewrites the raw 403 into a JSON-RPC 2.0 tool error carrying the identifier, so SDKs that treat a raw 403 as fatal keep the session alive."
    },
    {
      "id": "narrowing",
      "term": "Policy, not scopes",
      "definition": "Per-tool narrowing happens in the Authorize policy decision, not in the token: the OBO token carries api:read api:write api:delete end to end."
    }
  ],
